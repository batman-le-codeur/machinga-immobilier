# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ta-cle-service-role-secrete

# --- Compte admin (site) ---
# Identifiants du compte administrateur (change-les avant la mise en ligne)
ADMIN_EMAIL=admin@machinga-immobilier.com
ADMIN_PASSWORD=change-moi

# Phrase secrete utilisee pour signer le cookie de session admin (chaine aleatoire longue)
SESSION_SECRET=remplace-par-une-longue-chaine-aleatoire

# Cle publique Web3Forms (gratuite sur https://web3forms.com), pour l'envoi
# d'email de notification quand un visiteur envoie le formulaire de contact.
# Prefixe NEXT_PUBLIC_ obligatoire : l'appel est fait depuis le navigateur
# (Web3Forms refuse les appels serveur sur le plan gratuit).
NEXT_PUBLIC_WEB3FORMS_KEY=ta-cle-web3forms

# --- Emails automatiques (espace proprietaire) ---
# Serveur SMTP utilise pour : lien de reinitialisation du mot de passe,
# annonce publiee / refusee (au proprietaire), nouvelle annonce a valider (a
# CONTACT_EMAIL). Sans SMTP_HOST, les emails sont seulement ecrits dans les
# logs du serveur.
# Boite mail pro Hostinger (hPanel > Emails). SMTP_USER doit etre une VRAIE
# boite (un alias n'a pas de mot de passe et la connexion echoue) ;
# SMTP_FROM peut etre un alias de cette boite (ex. noreply@).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@machinga-immobilier.com
SMTP_PASS=mot-de-passe-de-la-boite
SMTP_FROM=MACHINGA IMMOBILIER <noreply@machinga-immobilier.com>

# Nombre maximum d'annonces qu'un proprietaire peut deposer par 24 h (defaut 5)
OWNER_DAILY_LISTING_LIMIT=5

# Coordonnees affichees sur le site (optionnel, sinon valeurs par defaut dans le code)
CONTACT_TELEPHONE=+241 00 00 00 00
CONTACT_EMAIL=contact@machinga-immobilier.com

# URL publique du site (sert a generer les liens absolus dans les balises
# meta de partage/SEO) : remplace par ton vrai domaine une fois deploye
NEXT_PUBLIC_SITE_URL=https://machinga-immobilier.com
